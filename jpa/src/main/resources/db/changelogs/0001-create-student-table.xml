<?xml version="1.0" encoding="UTF-8" ?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="1792861099523-1" author="abdelaziz">
        <createTable tableName="students">
            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_students_id"/>
            </column>
            <column name="full_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="age" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="java.sql.Types.VARCHAR">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="java.lang.String">
                <constraints nullable="false"/>
            </column>
            <column name="is_login" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="score" type="FLOAT"/>
            <column name="final_score" type="JAVA.LANG.FLOAT"/>
        </createTable>

        <rollback>
            <dropTable tableName="students"/>
        </rollback>
    </changeSet>

    <changeSet id="1792861996124-1" author="abdelaziz">
        <addColumn tableName="students">
            <column name="created_at" type="TIMESTAMP"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="students" columnName="created_at"/>
        </rollback>
    </changeSet>

    <changeSet id="1792862374931-1" author="mostafa">
        <addColumn tableName="students">
            <column name="is_archived" type="BOOLEAN"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="students" columnName="is_archived"/>
        </rollback>
    </changeSet>
</databaseChangeLog>